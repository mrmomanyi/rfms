# Copy this file to .env and edit. Never commit .env to version control.

# Development: True. Production: False.
DJANGO_DEBUG=True

# Required when DJANGO_DEBUG is False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Comma-separated hostnames for production, e.g. rfms.example.org
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=https://rfms.example.org

# Leave DB_NAME empty to use SQLite. Set these to use PostgreSQL.
# DB_NAME=rfms
# DB_USER=rfms
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Rankings: count only trees a reviewer has verified?
RFMS_RANK_VERIFIED_ONLY=False
# Seconds to cache the scorecard (0 disables caching)
RFMS_SCORECARD_CACHE_SECONDS=300
